PORT=5000
# No quotes. For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/gupta_traders?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gupta_traders
# Fix querySrv ECONNREFUSED on Windows / strict networks (Google + Cloudflare DNS)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Admin portal (not in MongoDB — validated only via POST /api/auth/admin/login)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password-min-8-chars
ADMIN_DISPLAY_NAME=System Admin
# Optional: bcrypt hash instead of plain ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# DigitalOcean Spaces (S3-compatible file storage)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=blr1
# Optional: override endpoint (default https://{DO_SPACES_REGION}.digitaloceanspaces.com)
# DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# Optional: CDN/public base URL for file links (e.g. https://bucket.blr1.cdn.digitaloceanspaces.com)
# DO_SPACES_PUBLIC_URL=
# On API startup, Spaces bucket CORS is set to CORS_ORIGIN so browsers can PUT files
# directly (needed on DigitalOcean App Platform where request bodies over ~1MB are blocked).

# Docker Compose (apps/api/docker-compose.yml) — optional overrides
# API_PORT=5000
# MONGO_ROOT_USERNAME=gupta
# MONGO_ROOT_PASSWORD=changeme
